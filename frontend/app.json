{
  "expo": {
    "name": "SEC Cricket Club",
    "slug": "sec-cricket-club",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "seccricketclub",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.seccricketclub.app",
      "googleServicesFile": "./GoogleService-Info.plist",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSCameraUsageDescription": "SEC Cricket Club requires camera access to take your profile picture, visiting card photos, and business flyer images.",
        "NSPhotoLibraryUsageDescription": "SEC Cricket Club requires photo library access to upload your profile picture, business logo, visiting card, and business flyer images.",
        "NSPhotoLibraryAddUsageDescription": "SEC Cricket Club requires permission to save business cards and images to your photo gallery."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1A2744",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.seccricketclub.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "CAMERA",
        "READ_MEDIA_IMAGES",
        "POST_NOTIFICATIONS",
        "INTERNET"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-apple-authentication",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A2744",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 180
        }
      ],
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "cameraPermission": "SEC Cricket Club requires camera access to take your profile picture, visiting card photos, and business flyer images.",
          "photosPermission": "SEC Cricket Club requires photo library access to upload your profile picture, business logo, visiting card, and business flyer images.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#1A2744",
          "defaultChannel": "default",
          "sounds": []
        }
      ],
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.837780082237-gmj2oqqtv9ek1a4h1pnrnpfjvr59ktnj"
        }
      ],
      "expo-image"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "8f3b5bfb-f214-44d1-b725-ee0ce6302ee3"
      }
    }
  }
}
