# Google Sign-In (Web client type 3 is required for idToken; iOS client from GoogleService-Info.plist)
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=837780082237-n5fr5566aibc80v5ula2ssljqivuf98t.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=837780082237-gmj2oqqtv9ek1a4h1pnrnpfjvr59ktnj.apps.googleusercontent.com

# Firebase (JS SDK) — public client config
